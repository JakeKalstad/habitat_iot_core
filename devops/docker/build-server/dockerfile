# Use Ubuntu as the base image
FROM ubuntu:24.10

# Set environment variables for non-interactive installs
ENV DEBIAN_FRONTEND=noninteractive

# Update and install necessary packages
RUN apt-get update && \
    apt-get install -y \
    nginx \
    git \
    curl \
    build-essential \
    libssl-dev \
    pkg-config \
    python3 \
    python3-pip \
    postgresql \
    supervisor \
    wget && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install rustup
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

# Install MinIO server and client
RUN wget https://dl.min.io/server/minio/release/linux-amd64/minio && \
    chmod +x minio && \
    mv minio /usr/local/bin/ && \
    wget https://dl.min.io/client/mc/release/linux-amd64/mc && \
    chmod +x mc && \
    mv mc /usr/local/bin/

# Install MQTT broker (Mosquitto)
RUN apt-get update && apt-get install -y mosquitto mosquitto-clients && \
    systemctl enable mosquitto.service

# Install MkDocs
RUN pip3 install mkdocs mkdocs-material

# Setup PostgreSQL
USER postgres
RUN /etc/init.d/postgresql start && \
    psql --command "CREATE USER buildserver WITH SUPERUSER PASSWORD 'password';" && \
    createdb buildserver_db -O buildserver
USER root

# Configure Supervisor to manage services
RUN mkdir -p /etc/supervisor/conf.d
COPY supervisord.conf /etc/supervisor/supervisord.conf

# Expose necessary ports
EXPOSE 80 443 9000 1883 5432

# Add entrypoint script
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Set entrypoint
ENTRYPOINT ["/entrypoint.sh"]
